{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "docs/index.html", "use": "@vercel/static" },
    { "src": "docs/products.html", "use": "@vercel/static" },
    { "src": "docs/navbar.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/navbar.html", "dest": "docs/navbar.html" },
    { "src": "/products.html", "dest": "docs/products.html" },
    { "src": "/(.*)", "dest": "docs/index.html" }
  ]
}
